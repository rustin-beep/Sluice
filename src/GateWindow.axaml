<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sluice.GateWindow"
        Title="Sluice"
        Width="600" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        FontFamily="{DynamicResource SluiceFontUi}"
        Background="{DynamicResource SluiceWinBgBrush}">

  <DockPanel>

    <!-- 顶部倒计时进度条：满格=刚弹出；颜色三档随剩余时间变化（样式见 App.axaml） -->
    <ProgressBar DockPanel.Dock="Top" x:Name="TimeBar" Classes="sluice-time tier-normal"
                 Height="3" MinHeight="3" Minimum="0" Maximum="60"/>

    <StackPanel Margin="16" Spacing="10">

      <!-- 标题行：警示图标 + 标题 + 倒计时 pill -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource SluiceFontIcon}" FontSize="16"
                     Foreground="{DynamicResource SluiceWarnIconBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="Agent 请求执行对外动作" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Column="1" x:Name="CountPill" Classes="sluice-pill tier-normal">
          <TextBlock x:Name="Countdown" Text="60s"/>
        </Border>
      </Grid>

      <!-- 元数据行：op 徽标（按操作类型着色） + 仓库/目标（等宽） + 指纹 -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Grid.Column="0" x:Name="OpBadge" Classes="sluice-op op-neutral">
          <TextBlock x:Name="OpText"/>
        </Border>
        <TextBlock Grid.Column="1" x:Name="RepoText" Margin="8,0,8,0"
                   FontFamily="{DynamicResource SluiceFontMono}" FontSize="13"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" x:Name="ShaText" FontFamily="{DynamicResource SluiceFontMono}" FontSize="12"
                   Foreground="{DynamicResource SluiceFg2Brush}" VerticalAlignment="Center"/>
      </Grid>

      <!-- 正文卡片；底部留白让浮动按钮不遮正文 -->
      <StackPanel Spacing="5">
        <TextBlock Text="正文（批准你所见；长文需滚动到底才可批准）" FontSize="12"
                   Foreground="{DynamicResource SluiceFg2Brush}"/>
        <Border Classes="sluice-card">
          <Grid>
            <ScrollViewer x:Name="BodyScroll" MinHeight="120" MaxHeight="440"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TextBlock x:Name="BodyText" TextWrapping="Wrap" Margin="12,10,12,46"/>
            </ScrollViewer>
            <Button x:Name="JumpToEnd" Classes="sluice-jump" Click="OnJumpToEnd"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource SluiceFontIcon}" FontSize="10"
                           VerticalAlignment="Center"/>
                <TextBlock Text="跳到底部" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </StackPanel>

      <!-- 警告 banner（红底，替代原裸红字） -->
      <Border x:Name="WarnBanner" Classes="sluice-banner sluice-banner-danger" IsVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource SluiceFontIcon}" FontSize="14"
                     Foreground="{DynamicResource SluiceBannerDFgBrush}" VerticalAlignment="Top"/>
          <TextBlock x:Name="WarnText" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- 拒绝理由 -->
      <StackPanel Spacing="5" Margin="0,2,0,0">
        <TextBlock Text="拒绝理由（可选，会反馈给 agent）" FontSize="12"
                   Foreground="{DynamicResource SluiceFg2Brush}"/>
        <Grid ColumnDefinitions="Auto,*">
          <ComboBox Grid.Column="0" x:Name="PresetBox" MinWidth="152" SelectedIndex="0">
            <ComboBoxItem Content="不批准"/>
            <ComboBoxItem Content="目标不对"/>
            <ComboBoxItem Content="内容需修改"/>
            <ComboBoxItem Content="我自己处理"/>
            <ComboBoxItem Content="任务重新讨论"/>
          </ComboBox>
          <TextBox Grid.Column="1" x:Name="FreeText" PlaceholderText="自由附言（可选）" Margin="8,0,0,0"/>
        </Grid>
      </StackPanel>

      <!-- UI-2/4：等待同意因子 / 因子取消的可见状态（banner 化） -->
      <Border x:Name="StatusBanner" Classes="sluice-banner sluice-banner-warn" IsVisible="False">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
      </Border>

      <!-- Linux 强档口令面板（v2.38）：批准点击后展开——口令即批准事件与解密因子（等价 Hello 的
           批准后生物验证）。Windows 构建下永不展开；KeyDown 处理器在代码后置按平台挂接。 -->
      <StackPanel x:Name="PassPanel" Spacing="6" IsVisible="False" Margin="0,2,0,0">
        <TextBlock Text="输入 vault 口令完成批准（回车确认；输错可重试，拒绝随时可用）" FontSize="12"
                   Foreground="{DynamicResource SluiceFg2Brush}"/>
        <TextBox x:Name="PassBox" PasswordChar="●" PlaceholderText="vault 口令" MinHeight="32"/>
      </StackPanel>

      <!-- 按钮行：拒绝=红（默认焦点在此）；批准=accent，未读完禁用 -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,2,0,0">
        <Button x:Name="DenyBtn" Classes="sluice-danger" Content="拒 绝" MinWidth="96" MinHeight="34" Click="OnDeny"/>
        <Button x:Name="ApproveBtn" Content="批 准" MinWidth="132" MinHeight="34" FontWeight="SemiBold"
                Click="OnApprove" IsEnabled="False"/>
      </StackPanel>

      <TextBlock x:Name="FootNote" Text="Enter / Esc = 拒绝 · 批准需先阅读至正文底部 · 剩 15 秒时任务栏闪烁召回"
                 HorizontalAlignment="Center" FontSize="11.5" Opacity="0.55"/>

    </StackPanel>
  </DockPanel>
</Window>
