<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AssemblyName>sluice</AssemblyName>
    <RootNamespace>Sluice</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 探针定稿：NativeAOT（启动 ~100ms，exe 19MB）；AOT 隐含 trimming -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <!-- 探针工程独立构建，不进本工程 -->
  <ItemGroup>
    <Compile Remove="probes/**/*.cs" />
    <AvaloniaResource Remove="probes/**/*.axaml" />
    <AvaloniaXaml Remove="probes/**/*.axaml" />
    <None Remove="probes/**" />
  </ItemGroup>

</Project>
