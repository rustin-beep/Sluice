<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AssemblyName>sluice</AssemblyName>
    <RootNamespace>Sluice</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 探针定稿：NativeAOT（启动 ~100ms，exe 19MB）；AOT 隐含 trimming -->
    <PublishAot>true</PublishAot>
    <Version>0.6.5</Version>
  </PropertyGroup>

  <!-- B2（2026-10-30 实战）：构建时间戳 + git sha 内嵌为 AssemblyMetadata，
       version 命令 / 未知命令 / 未知参数消息自报家门——新旧 exe 混用一眼可辨，
       旧构建缺新动词时不再裸报"无法识别的参数"。git 不可用时容错为 "-"。
       v2.5 评审补：工作树非干净（对 HEAD 有 tracked 改动）时 sha 附 +dirty——
       本工作流常带未提交修复 publish，脏树构建必须与干净构建可辨。 -->
  <Target Name="EmbedBuildInfo" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <BuildTimestampUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm"))UTC</BuildTimestampUtc>
    </PropertyGroup>
    <Exec Command="git rev-parse --short=8 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitSha8" />
    </Exec>
    <PropertyGroup>
      <GitSha8 Condition="'$(GitSha8)' == ''">-</GitSha8>
    </PropertyGroup>
    <Exec Command="git diff --quiet HEAD" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="GitTreeState" />
    </Exec>
    <PropertyGroup>
      <!-- 退出码 0=干净树，非 0=有 tracked 改动或 git 不可用；sha 为 "-"（git 缺失）时不叠 dirty -->
      <GitSha8 Condition="'$(GitSha8)' != '-' AND '$(GitTreeState)' != '' AND '$(GitTreeState)' != '0'">$(GitSha8)+dirty</GitSha8>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SluiceBuildTimestamp</_Parameter1>
        <_Parameter2>$(BuildTimestampUtc)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SluiceGitSha</_Parameter1>
        <_Parameter2>$(GitSha8)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <!-- 探针工程独立构建，不进本工程 -->
  <ItemGroup>
    <Compile Remove="probes/**/*.cs" />
    <AvaloniaResource Remove="probes/**/*.axaml" />
    <AvaloniaXaml Remove="probes/**/*.axaml" />
    <None Remove="probes/**" />
  </ItemGroup>

</Project>
